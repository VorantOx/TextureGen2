{
  "python.defaultInterpreterPath": "C:\\Python39\\python.exe",
  "python.analysis.extraPaths": [
    "${workspaceFolder}"
  ],
  "files.encoding": "utf8",
  "terminal.integrated.defaultProfile.windows": "PowerShell",
  "editor.rulers": [
    100
  ],
  "files.exclude": {
