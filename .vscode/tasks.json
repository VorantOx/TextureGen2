{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "OTWN: wait for editor",
      "type": "process",
      "command": "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/.vscode/wait-for-editor.ps1"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "OTWN: stop editor on 8765",
      "type": "process",
      "command": "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/.vscode/stop-editor.ps1"
      ],
      "problemMatcher": []
    },
    {
      "label": "OTWN: open in Yandex",
      "type": "process",
      "command": "C:\\Program Files\\Yandex\\YandexBrowser\\Application\\browser.exe",
      "args": [
        "http://127.0.0.1:8765/"
      ],
      "problemMatcher": []
    },
    {
      "label": "OTWN: compile Python",
      "type": "process",
      "command": "C:\\Python39\\python.exe",
      "args": [
        "-m",
        "py_compile",
        "make_otwn_textures.py",
        "otwn_pipeline.py",
        "otwn_editor.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
